<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ModelViewer3D" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/bg_surface</item>
        <item name="colorPrimaryVariant">@color/bg_medium</item>
        <item name="colorOnPrimary">@color/text_primary</item>
        <item name="colorSecondary">@color/accent_cyan</item>
        <item name="colorOnSecondary">#000000</item>
        <item name="colorSurface">@color/bg_surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:colorBackground">@color/bg_dark</item>
        <item name="android:statusBarColor">@color/bg_deepest</item>
        <item name="android:navigationBarColor">@color/bg_deepest</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="bottomSheetDialogTheme">@style/BottomSheetStyle</item>
    </style>

    <!-- High-contrast overflow menu used over the dark 3D viewport. -->
    <style name="ThemeOverlay_AuraPopup" parent="ThemeOverlay.MaterialComponents.Dark">
        <item name="android:colorBackground">#172235</item>
        <item name="android:textColorPrimary">#F2F6FB</item>
        <item name="android:textColorSecondary">#C8D6E8</item>
        <item name="android:windowMinWidthMajor">65%</item>
        <item name="android:windowMinWidthMinor">80%</item>
    </style>

    <style name="BottomSheetStyle" parent="Theme.Design.Light.BottomSheetDialog">
        <item name="android:windowIsFloating">false</item>
        <item name="bottomSheetStyle">@style/BottomSheetShapeStyle</item>
    </style>

    <style name="BottomSheetShapeStyle" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
    </style>

    <!-- Top-bar icon button (Undo/Redo/Reset/Overflow) -->
    <style name="TopBarBtn">
        <item name="android:layout_width">36dp</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:padding">8dp</item>
        <item name="android:layout_marginStart">1dp</item>
        <item name="android:layout_marginEnd">1dp</item>
        <item name="android:scaleType">centerInside</item>
        <item name="android:background">@drawable/bg_top_bar_btn</item>
        <item name="android:tint">@color/text_secondary</item>
    </style>

    <style name="ToolDockItem">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
        <item name="android:layout_marginStart">3dp</item>
        <item name="android:layout_marginEnd">3dp</item>
        <item name="android:background">@drawable/bg_tool_button</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="ToolDockIcon">
        <item name="android:layout_width">25dp</item>
        <item name="android:layout_height">25dp</item>
        <item name="android:tint">@color/tool_idle_icon</item>
    </style>

    <style name="ToolDockLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/tool_idle_label</item>
        <item name="android:textSize">9sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:paddingTop">4dp</item>
    </style>

    <!-- Legacy ToolbarBtn kept for backward compat (now hidden in new layout) -->
    <style name="TopBarBtnAccent">
        <item name="android:layout_width">36dp</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:padding">8dp</item>
        <item name="android:layout_marginStart">1dp</item>
        <item name="android:layout_marginEnd">1dp</item>
        <item name="android:scaleType">centerInside</item>
        <item name="android:background">@drawable/bg_top_bar_btn</item>
        <item name="android:tint">@color/accent_cyan</item>
    </style>

    <style name="ToolbarBtn">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:padding">10dp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:tint">@color/text_secondary</item>
    </style>

    <style name="ToolbarBtnAccent">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:padding">10dp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:tint">@color/accent_cyan</item>
    </style>
</resources>
